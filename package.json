{
  "name": "coding-island",
  "private": true,
  "description": "Alat build Coding Island. Hasil build (css/tailwind.css, js/vendor/, fonts/) di-commit karena deploy tidak menjalankan build.",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.cjs -i src/tailwind.css -o css/tailwind.css --minify",
    "build:vendor": "node scripts/build-vendor.mjs",
    "build": "npm run build:vendor && npm run build:css",
    "schema": "node scripts/buat-schema.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.16.0",
    "@codemirror/commands": "6.5.0",
    "@codemirror/language": "6.10.1",
    "@codemirror/state": "6.4.1",
    "@codemirror/view": "6.26.3",
    "@fontsource-variable/baloo-2": "5.2.5",
    "@fontsource-variable/jetbrains-mono": "5.2.5",
    "@fontsource-variable/nunito": "5.2.5",
    "@lezer/highlight": "1.2.0",
    "canvas-confetti": "1.9.3",
    "esbuild": "0.25.0",
    "tailwindcss": "3.4.16",
    "wrangler": "4.152.0"
  },
  "allowScripts": {
    "esbuild@0.25.0": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
