# _headers — header untuk berkas statis yang dilayani Worker (binding ASSETS)

# Header keamanan dasar untuk semua halaman dan berkas
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# JS & CSS: browser selalu memeriksa ulang (jawaban 304 bila tidak berubah),
# jadi pembaruan langsung terasa tanpa Ctrl+F5
/js/*
  Cache-Control: no-cache

/css/*
  Cache-Control: no-cache

# Gambar & font jarang berubah: simpan 7 hari (604800 detik)
/image/*
  Cache-Control: public, max-age=604800

/fonts/*
  Cache-Control: public, max-age=604800
